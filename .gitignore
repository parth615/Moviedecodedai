# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database
prisma/*.db
prisma/*.db-journal

# User Uploads & Renders
public/video/*
public/videos/*
public/audio/*
!public/video/.gitkeep
!public/videos/.gitkeep
!public/audio/.gitkeep
!public/audio/mock.mp3
!public/images/*
*.mov

